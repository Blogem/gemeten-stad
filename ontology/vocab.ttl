# De Gemeten Stad — SKOS domain vocabulary (v0)
# ============================================================================
# GENERATED by ontology/generate_vocab.py from the loaded Postgres value store +
# hand-authored legal/activity concepts. Regenerate with that script; do not hand-edit.
#
# Seeded from authoritative sources, not invented (design.md D7). Identity rests on
# codes/IRIs (skos:notation), never on names. Concepts are city-wide.
#
# DEFERRED axes (recorded so scale-up is planned, not a surprise — D8):
#   • boomgebreken (tree defects) — NOT a stamgegevens field; it is the separate
#     un-ingested `gebrekregistratie` dataset. Landing it is a load/bomen (P7) scope
#     addition, not a p8-modeling task.
#   • corpus-mined surface variants (abbreviations, "t.h.v.", cultivar phrasings) —
#     Phase 2 feedback loop, which mines the Noord backfill corpus first.
#   • a second intervention type's vocabulary slices — Phase 4 (IMPLEMENTATION_PLAN §6).
#   • skos:exactMatch alignment to TOOI/IMBOR/Soortenregister — best-effort; v0 keeps
#     local IRIs + dct:source (D7 permits this). No re-minted parallel identifiers.
#
# Grammatical plurals ARE authored city-wide in v0 (no inflection gap).
#
# PLACES ARE NOT SEEDED as concepts. A gebieden/CBS place's meaning is its geometry + admin
# hierarchy, authoritative in PostGIS (gebieden_buurten: naam+code+geom+ligtinwijkid). The vocab
# holds only concepts whose meaning is NOT already in the value store; a SKOS name→code shadow
# adds nothing and any real place query needs PostGIS anyway. Places live as gs:Place instance
# nodes keyed by their code; the analytics agent queries the locations data directly (Phase 2).
# ============================================================================

@prefix gs:   <http://gemetenstad.nl/ns#> .
@prefix data: <http://gemetenstad.nl/id/> .
@prefix sch:  <http://gemetenstad.nl/id/scheme/> .
@prefix con:  <http://gemetenstad.nl/id/concept/> .
@prefix act:  <http://gemetenstad.nl/id/activity/> .
@prefix sts:  <http://gemetenstad.nl/id/status/> .
@prefix sp:   <http://gemetenstad.nl/id/species/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

sch:tree-audit a skos:ConceptScheme ;
    skos:prefLabel "Gemeten Stad tree-audit vocabulary"@en ;
    dct:source <https://lokaleregelgeving.overheid.nl/CVDR323217/2> , <https://lokaleregelgeving.overheid.nl/CVDR697591> .

# ===== Activity concepts (Bomenverordening art. 1k; Spike C: verplanten ≡ vellen) =====

act:vellen a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "vellen"@nl ;
    skos:altLabel "kappen"@nl , "rooien"@nl , "kandelaberen"@nl , "verplanten"@nl ,
                  "vel"@nl , "kap"@nl , "gekapt"@nl , "gerooid"@nl , "geveld"@nl , "verplant"@nl ;
    skos:notation "Vellen (boom verwijderen)" ;
    skos:definition "Rooien, kappen, kandelaberen of verplanten, evenals handelingen die de dood of ernstige beschadiging of ontsiering van de houtopstand tot gevolg kunnen hebben."@nl ;
    skos:scopeNote "One felling concept: verplanten is a velling by law (Bomenverordening art. 1k) and the registry has no separate Verplanten value (Spike C). A transplant is counted with the felling total and flagged gs:transplantOrigin."@nl ;
    dct:source <https://lokaleregelgeving.overheid.nl/CVDR323217/2> .

act:herplanten a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "herplanten"@nl ;
    skos:altLabel "herplant"@nl , "planten"@nl , "aanplanten"@nl , "aanplant"@nl , "herplanting"@nl ;
    skos:scopeNote "The replant/fulfilment side. Counts on the replant side only — NEVER in the felling obligation total (Spike C)."@nl ;
    dct:source <https://lokaleregelgeving.overheid.nl/CVDR323217/2> .

# ===== Legal-top concepts (derived from the two CVDR texts; dct:source per article) =====

con:boom a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "boom"@nl ;
    skos:altLabel "stamomtrek"@nl ;
    skos:definition "Een houtachtig, opgaand gewas, levend of afgestorven, met een omtrek van de stam van minimaal 31 centimeter op 130 centimeter hoogte boven het maaiveld; bij meerstammigheid geldt de omtrek van de dikste stam."@nl ;
    skos:scopeNote "Bomenverordening 2014 art. 1b — the 31 cm stamomtrek threshold that makes a tree permit-relevant."@nl ;
    dct:source <https://lokaleregelgeving.overheid.nl/CVDR323217/2> .

con:houtopstand a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "houtopstand"@nl ;
    skos:altLabel "houtopstanden"@nl ;
    skos:definition "Één of meer bomen, hakhout, boomvormers of andere houtachtige gewassen die onderdeel uitmaken van een houtwal, (lint)begroeiing of bosplantsoen, met de onder art. 1b genoemde minimale omtrek."@nl ;
    skos:scopeNote "Bomenverordening 2014 art. 1f."@nl ;
    dct:source <https://lokaleregelgeving.overheid.nl/CVDR323217/2> .

con:kandelaberen a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "kandelaberen"@nl ;
    skos:definition "Het voor meer dan 20% gelijkmatig weghalen van de takken die de kroon van een boom vormen."@nl ;
    skos:scopeNote "Bomenverordening 2014 art. 1h — a form of vellen (art. 1k)."@nl ;
    dct:source <https://lokaleregelgeving.overheid.nl/CVDR323217/2> .

con:beschermwaardige-houtopstand a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "beschermwaardige houtopstand"@nl ;
    skos:altLabel "monumentale boom"@nl , "waardevolle houtopstand"@nl ;
    skos:definition "Houtopstand die geplaatst is op de lijst als bedoeld in artikel 10."@nl ;
    skos:scopeNote "Bomenverordening 2014 art. 1a / art. 10 — the protected-tree list (colloquially 'monumentale boom')."@nl ;
    dct:source <https://lokaleregelgeving.overheid.nl/CVDR323217/2> .

con:monetaire-boomwaarde a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "monetaire boomwaarde"@nl ;
    skos:altLabel "boomwaarde"@nl ;
    skos:definition "De financiële waarde van een boom of houtopstand, getaxeerd volgens de actuele richtlijnen van de Nederlandse Vereniging van Taxateurs van Bomen (NVTB)."@nl ;
    skos:scopeNote "Bomenverordening 2014 art. 1j — the value stored in the herplantfonds when replanting in kind is impossible."@nl ;
    dct:source <https://lokaleregelgeving.overheid.nl/CVDR323217/2> .

con:herplantplicht a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "herplantplicht"@nl ;
    skos:altLabel "herplantverplichting"@nl ;
    skos:definition "Het college verbindt aan de vergunning het voorschrift dat binnen een te bepalen termijn en volgens aanwijzingen wordt herplant, tenzij zwaarwegende argumenten zich daartegen verzetten."@nl ;
    skos:scopeNote "Bomenverordening 2014 art. 7 lid 1 — the replanting obligation the audit tests."@nl ;
    dct:source <https://lokaleregelgeving.overheid.nl/CVDR323217/2> .

con:herplantfonds a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "herplantfonds"@nl ;
    skos:altLabel "herplantregeling"@nl ;
    skos:definition "Fonds waarin de monetaire boomwaarde van de gevelde houtopstand wordt gestort wanneer herplant ter plaatse niet mogelijk is (art. 7 lid 3); de gelden worden geoormerkt voor compensatie elders."@nl ;
    skos:scopeNote "Bomenverordening 2014 art. 7 lid 3."@nl ;
    dct:source <https://lokaleregelgeving.overheid.nl/CVDR323217/2> .

con:herplantcompensatie a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "herplantcompensatie"@nl ;
    skos:altLabel "compensatie"@nl , "boomjaren"@nl ;
    skos:definition "Het aantal te herplanten bomen wordt bepaald door de leeftijd van de gevelde boom in leeftijdsklassen van 8 jaar (Omrekentabel). Een vervangende boom heeft standaard een stamomtrek van 18–20 cm op 1 m hoogte; men mag minder maar dikkere bomen herplanten mits dezelfde fysieke boomwaarde."@nl ;
    skos:scopeNote "Compensatie en herplant van bomen (beleidsregel bij art. 7 Bomenverordening 2014) — the Omrekentabel. NB: the ladder is keyed on the felled tree's AGE (leeftijdsklassen), not its diameter."@nl ;
    dct:source <https://lokaleregelgeving.overheid.nl/CVDR697591> .

# ----- Omrekentabel: replant obligation by felled-tree age class (CVDR697591) -----

con:leeftijdsklasse-tot-15 a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "leeftijdsklasse tot en met 15 jaar"@nl ;
    skos:broader con:herplantcompensatie ;
    skos:scopeNote "1 te herplanten boom (stamomtrek 18–20 cm). Omrekentabel, Compensatie en herplant van bomen (CVDR697591)."@nl ;
    dct:source <https://lokaleregelgeving.overheid.nl/CVDR697591> .

con:leeftijdsklasse-16-23 a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "leeftijdsklasse 16–23 jaar"@nl ;
    skos:broader con:herplantcompensatie ;
    skos:scopeNote "2 te herplanten bomen (18–20 cm), of één boom van 20–25 cm. Omrekentabel, Compensatie en herplant van bomen (CVDR697591)."@nl ;
    dct:source <https://lokaleregelgeving.overheid.nl/CVDR697591> .

con:leeftijdsklasse-24-31 a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "leeftijdsklasse 24–31 jaar"@nl ;
    skos:broader con:herplantcompensatie ;
    skos:scopeNote "3 te herplanten bomen (18–20 cm), of één boom van 25–30 cm. Omrekentabel, Compensatie en herplant van bomen (CVDR697591)."@nl ;
    dct:source <https://lokaleregelgeving.overheid.nl/CVDR697591> .

con:leeftijdsklasse-32-39 a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "leeftijdsklasse 32–39 jaar"@nl ;
    skos:broader con:herplantcompensatie ;
    skos:scopeNote "4 te herplanten bomen (18–20 cm), of één boom van 30–35 cm. Omrekentabel, Compensatie en herplant van bomen (CVDR697591)."@nl ;
    dct:source <https://lokaleregelgeving.overheid.nl/CVDR697591> .

con:leeftijdsklasse-40-47 a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "leeftijdsklasse 40–47 jaar"@nl ;
    skos:broader con:herplantcompensatie ;
    skos:scopeNote "5 te herplanten bomen (18–20 cm), of één boom van 35–40 cm. Omrekentabel, Compensatie en herplant van bomen (CVDR697591)."@nl ;
    dct:source <https://lokaleregelgeving.overheid.nl/CVDR697591> .

# ===== Status: boomAanwezigheid (the fulfilment axis, Spike C) =====

sts:ja a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "Ja"@nl ;
    skos:notation "Ja" ;
    skos:scopeNote "kapenherplant.boomAanwezigheid value — the observed replant-fulfilment signal."@nl .

sts:ja-boom-handhaven a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "Ja, boom handhaven"@nl ;
    skos:notation "Ja, boom handhaven" ;
    skos:scopeNote "kapenherplant.boomAanwezigheid value — the observed replant-fulfilment signal."@nl .

sts:ja-nieuwe-boom-reeds-aangeplant a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "Ja, nieuwe boom reeds aangeplant"@nl ;
    skos:notation "Ja, nieuwe boom reeds aangeplant" ;
    skos:scopeNote "kapenherplant.boomAanwezigheid value — the observed replant-fulfilment signal."@nl .

sts:nee a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "Nee"@nl ;
    skos:notation "Nee" ;
    skos:scopeNote "kapenherplant.boomAanwezigheid value — the observed replant-fulfilment signal."@nl .

sts:niet-te-beoordelen a skos:Concept ;
    skos:inScheme sch:tree-audit ;
    skos:prefLabel "Niet te beoordelen"@nl ;
    skos:notation "Niet te beoordelen" ;
    skos:scopeNote "kapenherplant.boomAanwezigheid value — the observed replant-fulfilment signal."@nl .

