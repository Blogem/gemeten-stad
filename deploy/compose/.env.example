# Dev-compose configuration. Copy to `.env` and edit as needed.
# The stack also runs with no .env — every var has a default in compose.yaml.

# --- PostGIS (value + geometry store) ---
POSTGRES_DB=gemeten_stad
POSTGRES_USER=gs
POSTGRES_PASSWORD=gs
POSTGRES_PORT=5433          # host port; container is always 5432

# --- Fuseki (RDF graph store) ---
FUSEKI_ADMIN_PASSWORD=admin # guards the update/SHACL endpoints
FUSEKI_PORT=3030            # host + container port (UI + endpoints; dataset /ds)

# --- Server ---
SERVER_PORT=8080            # host + container port; drives GS_SERVER_ADDR (":8080")
# Store connection config the server reads (GS_* is the stack-wide convention).
# Point at the in-network service names; override to target external stores.
GS_FUSEKI_URL=http://fuseki:3030/ds
GS_DATABASE_URL=postgres://gs:gs@db:5432/gemeten_stad

# --- Integration tests (Phase 0 · P5) ---
# Deliberately UNSET here, unlike every var above: the harness (internal/testdb)
# creates an isolated schema/dataset under whatever these point at, and aborts if
# the resolved name is gemeten_stad/public/ds — never point these at GS_DATABASE_URL
# or GS_FUSEKI_URL. From the host, after `task compose:up`:
# GS_TEST_DATABASE_URL=postgres://gs:gs@localhost:5433/gemeten_stad
# GS_TEST_FUSEKI_URL=http://localhost:3030
